{
  "name": "magician",
  "description": "MAGICIAN-style bounded debug run with moderate beam search and eleven observations.",
  "debug_only": true,
  "coverage_comparable": false,
  "output_suffix": "debug_magician",
  "overrides": {
    "validation_n_proxy_points": 200000,
    "beam_width": 5,
    "beam_steps": 5,
    "validation_n_interpolation_steps": 1,
    "validation_n_poses_in_trajectory": 10,
    "experiment_budget_observations": 11,
    "validation_max_start_positions": 1,
    "random_seed": 8,
    "torch_seed": 9
  }
}
