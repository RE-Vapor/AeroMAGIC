{
  "name": "pioneer-50",
  "description": "Fifty-observation PIONEER traversal with the quick profile's bounded proxy and beam settings.",
  "debug_only": true,
  "coverage_comparable": false,
  "output_suffix": "debug_pioneer50",
  "overrides": {
    "validation_n_proxy_points": 100000,
    "beam_width": 3,
