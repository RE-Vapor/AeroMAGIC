{
  "name": "large-scene",
  "description": "Large-scene traversal debug run with a longer observation budget and bounded beam search.",
  "debug_only": true,
  "coverage_comparable": false,
  "output_suffix": "debug_large_scene",
  "overrides": {
    "validation_n_proxy_points": 200000,
    "beam_width": 3,
    "beam_steps": 3,
    "validation_n_interpolation_steps": 1,
    "validation_n_poses_in_trajectory": 20,
    "experiment_budget_observations": 21,
    "validation_max_start_positions": 1,
    "random_seed": 8,
    "torch_seed": 9
  }
}
